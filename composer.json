{
    "name": "asignua/filament-spreadsheet-grid",
    "description": "Edit a Filament 5 table the way people edit a spreadsheet: arrow-key navigation, typing over a cell, mouse and Shift range selection, copy and paste TSV blocks from Excel, Google Sheets or LibreOffice, fill down and right, text/number/select/date/boolean cells, inline per-cell validation, dirty-cell highlighting and one \"Save all\" in a single transaction with per-row errors. Keeps your query, filters, pagination, policies and write path.",
    "keywords": ["filament", "filament-plugin", "laravel", "spreadsheet", "grid", "inline-edit", "bulk-edit", "table"],
    "homepage": "https://github.com/asignua/filament-spreadsheet-grid",
    "support": {
        "issues": "https://github.com/asignua/filament-spreadsheet-grid/issues",
        "source": "https://github.com/asignua/filament-spreadsheet-grid"
    },
    "license": "MIT",
    "authors": [
        {
            "name": "Mykhailo Hladchenko",
            "email": "myhailo@hotmail.com",
            "role": "Developer"
        }
    ],
    "require": {
        "php": "^8.3",
        "filament/filament": "^5.0",
        "illuminate/contracts": "^12.0|^13.0",
        "spatie/laravel-package-tools": "^1.16"
    },
    "require-dev": {
        "larastan/larastan": "^3.0",
        "laravel/pint": "^1.18",
        "orchestra/testbench": "^10.0|^11.0",
        "phpunit/phpunit": "^11.5|^12.0"
    },
    "autoload": {
        "psr-4": {
            "Asignua\\FilamentSpreadsheetGrid\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Asignua\\FilamentSpreadsheetGrid\\Tests\\": "tests/",
            "Workbench\\App\\": "workbench/app/",
            "Workbench\\Database\\Factories\\": "workbench/database/factories/"
        }
    },
    "extra": {
        "laravel": {
            "providers": [
                "Asignua\\FilamentSpreadsheetGrid\\SpreadsheetGridServiceProvider"
            ]
        }
    },
    "scripts": {
        "test": "vendor/bin/phpunit",
        "analyse": "vendor/bin/phpstan analyse --memory-limit=1G",
        "format": "vendor/bin/pint"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": false
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
