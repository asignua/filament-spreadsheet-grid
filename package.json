{
    "private": true,
    "type": "module",
    "scripts": {
        "build": "npm run build:css && npm run build:js",
        "build:css": "npx @tailwindcss/cli --input ./resources/css/index.css --output ./resources/dist/filament-spreadsheet-grid.css --minify",
        "build:js": "esbuild resources/js/index.js --bundle --format=esm --minify --target=es2020 --outfile=resources/dist/spreadsheet-grid.js",
        "test": "node --test \"tests-js/*.test.js\""
    },
    "devDependencies": {
        "@tailwindcss/cli": "^4.1.0",
        "esbuild": "^0.25.0",
        "jsdom": "^30.1.1",
        "tailwindcss": "^4.1.0"
    }
}
